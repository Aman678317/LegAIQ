# ============ Jurisiva AI — Environment Configuration ============
# Copy this file to .env and fill in real values. Never commit real secrets.

# --- Application ---
APP_NAME=Jurisiva AI
APP_VERSION=0.1.0
DEBUG=true

# --- Frontend (Next.js) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- AI Providers (at least one required for real AI features) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Local Ollama AI (Self-Hosted / Local LLMs) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434

# --- OCR ---
# Options: tesseract | google_vision | mock
OCR_PROVIDER=tesseract
TESSERACT_CMD=tesseract

# --- Web Research ---
SEARCH_API_KEY=

# --- Voice ---
STT_API_KEY=
TTS_API_KEY=

# --- LLM Defaults ---
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
